# Neo — example environment. Copy to .env and fill in what you want.
#
#   cp .env.example .env
#
# Onboarding writes GEMINI_API_KEY here for you, so on a normal install you
# never have to touch this file. Everything below is optional.
#
# .env is gitignored. Keys never leave your Mac except as Authorization
# headers to the provider they belong to.

# --------------------------------------------------------------------------
# The one key Neo needs. Free: https://aistudio.google.com/apikey
# --------------------------------------------------------------------------
GEMINI_API_KEY=

# The free allowance is per Google PROJECT, not per account — so a second
# project under the same account is a second full allowance. Neo rotates to the
# next key when one reports a daily limit. Up to _8.
#GEMINI_API_KEY_2=
#GEMINI_API_KEY_3=

# --------------------------------------------------------------------------
# Other providers. All optional; Neo runs on the Gemini key alone.
# A provider with no key here is skipped entirely, so adding one only ever
# adds a fallback. See providers.py for which job each candidate serves.
# --------------------------------------------------------------------------
#CEREBRAS_API_KEY=
#OPENROUTER_API_KEY=
#MISTRAL_API_KEY=
#HF_TOKEN=

# Providers that BILL are invisible to the resolver unless you name them here.
# This gate is enforced in providers.have(), not by a comment, because a
# comment once failed to stop exactly this: 26 paid calls the owner believed
# were free. Comma-separated, per provider.
#NEO_ALLOW_PAID=groq

# --------------------------------------------------------------------------
# Handing real work to an agent CLI (optional)
# --------------------------------------------------------------------------
# Folders Neo can run Claude Code / Codex in. Git repos in ~/Desktop, ~/code,
# ~/Projects, ~/Documents/GitHub and ~/dev are found automatically; this is for
# anything elsewhere, and it overrides what was guessed.
#NEO_PROJECTS=myapp=~/work/myapp,site=~/sites/site

# Speech-to-text mangles project names that aren't dictionary words, and it
# mangles them the same way every time. Map what you actually hear to the
# folder you named.
#NEO_PROJECT_ALIASES=my app=myapp,side project=sideproj

# --------------------------------------------------------------------------
# Behaviour switches (all have sensible defaults — see FEATURES.md)
# --------------------------------------------------------------------------
#NEO_HUSH=1              # listen for "shush" while Neo speaks (shows the orange mic dot)
#NEO_PTT=both            # Right-Option as a second push-to-talk key
#NEO_NO_PANEL=1          # no answer panel
#NEO_NO_HUD=1            # no status HUD
#NEO_NO_OVERLAY=1        # nothing on screen at all
#NEO_QUIET_HOURS=4       # how long focus mode lasts

# --------------------------------------------------------------------------
# Testing only
# --------------------------------------------------------------------------
#NEO_NO_AUDIO=1          # set by go.sh and by each suite; state goes to temp files
#NEO_MEMORY_AUDIT=1      # run the opt-in memory audit (needs .memory-audit)
#NEO_LIVE_TESTS=1        # allow tests that touch your real clipboard/files
